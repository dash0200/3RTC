{
  "id": "/",
  "name": "3RTC – Watch Together",
  "short_name": "3RTC",
  "description": "Watch YouTube or your own video files together in sync, with voice chat and live chat. Free, no sign-up, peer-to-peer.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0f0f0f",
  "theme_color": "#0a0a0c",
  "categories": [
    "entertainment",
    "social"
  ],
  "icons": [
    {
      "src": "/icons/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
